# Copy to local.env (git-ignored) and point FC_DATA_DIR at the external data root.
# The root must contain raw/fund.csv and raw/SHARADAR_INDICATORS_a3407c5c2ec46991d2b7ac667785d0d1.csv.
# An FC_DATA_DIR environment variable, when set, takes precedence over this file.
